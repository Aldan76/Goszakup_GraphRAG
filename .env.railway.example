# Railway Environment Variables Example
# Copy these to Railway dashboard and fill in your values

# ============================================
# TELEGRAM CONFIGURATION
# ============================================
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=8617987568:AAGkDlRS5yQxxfA2ZUrgTbQj-V3uFJGuKmU

# Admin user IDs (comma-separated)
TELEGRAM_ADMIN_IDS=123456789,987654321

# ============================================
# OPENAI CONFIGURATION
# ============================================
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Models
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4
OPENAI_FALLBACK_MODEL=gpt-3.5-turbo

# ============================================
# NEO4J CONFIGURATION
# ============================================
# Option 1: Use Neo4j Aura (cloud)
# Get from https://neo4j.com/cloud/aura/
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# Option 2: Use Neo4j on Railway (docker-compose)
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-strong-password

NEO4J_DATABASE=neo4j

# ============================================
# APPLICATION CONFIGURATION
# ============================================
LOG_LEVEL=INFO
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_RETRIEVAL_RESULTS=5
MAINTENANCE_MODE=false

# ============================================
# DATA PATHS (for Railway)
# ============================================
RAW_DATA_PATH=/app/data/raw
PROCESSED_DATA_PATH=/app/data/processed

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 1. In Railway dashboard, create these variables:
#    - Go to "Variables" tab
#    - Add each variable from above
#
# 2. For Neo4j:
#    Option A (Recommended): Use Neo4j Aura
#      - Create free instance at neo4j.com/cloud/aura
#      - Copy URI and password
#      - Use NEO4J_URI with neo4j+s:// prefix
#
#    Option B: Use Docker
#      - Railway will auto-create Neo4j service from docker-compose.yml
#      - Use NEO4J_URI=bolt://neo4j:7687
#
# 3. Railway will automatically:
#    - Install requirements from requirements.txt
#    - Build Docker image
#    - Start the bot
#    - Keep it running 24/7
#
# 4. Monitor logs in Railway dashboard under "Logs" tab
